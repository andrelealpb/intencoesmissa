{
  "name": "missas-intencoes",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:api": "pnpm --filter @missas/api dev",
    "dev:web": "pnpm --filter @missas/web dev",
    "dev:worker": "pnpm --filter @missas/worker dev",
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @missas/shared build",
    "build:api": "pnpm run build:shared && pnpm --filter @missas/api build",
    "build:web": "pnpm run build:shared && pnpm --filter @missas/web build",
    "build:worker": "pnpm run build:shared && pnpm --filter @missas/worker build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm exec prisma generate --schema=prisma/schema.prisma",
    "db:migrate:dev": "pnpm exec prisma migrate dev --schema=prisma/schema.prisma",
    "db:migrate:deploy": "pnpm exec prisma migrate deploy --schema=prisma/schema.prisma",
    "db:seed": "pnpm exec tsx prisma/seed.ts",
    "db:validate": "pnpm exec prisma validate --schema=prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^5.10.0",
    "tsx": "^4.7.0",
    "bcryptjs": "^2.4.3",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
