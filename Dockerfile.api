FROM node:22-slim AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Copy monorepo root files
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* .npmrc ./

# Copy packages
COPY packages/ ./packages/

# Copy prisma
COPY prisma/ ./prisma/

# Copy api app
COPY apps/api/ ./apps/api/

# Install dependencies
RUN pnpm install --frozen-lockfile || pnpm install

# Generate Prisma client
RUN pnpm exec prisma generate --schema=prisma/schema.prisma

# Build shared package first, then API
RUN pnpm --filter @missas/shared build && pnpm --filter @missas/api build

# Verify migration files exist
RUN ls -la prisma/migrations/ && echo "Migration files found"

# Create entrypoint script (migrate + start).
# O seed NÃO roda no deploy: ele repõe registros que o admin excluiu de
# propósito (ex.: horários de missa). Para popular um banco novo, rode
# `pnpm db:seed` manualmente (setup inicial). Deploy aplica só migrações.
COPY <<'ENTRY' /app/entrypoint.sh
#!/bin/sh
set -e
echo "=== Running Prisma migrations ==="
ls -la /app/prisma/migrations/
pnpm exec prisma migrate deploy --schema=prisma/schema.prisma
echo "=== Migrations complete ==="
echo "=== Starting API ==="
node apps/api/dist/main.js
ENTRY
RUN chmod +x /app/entrypoint.sh

EXPOSE 3001
ENV PORT=3001

ENTRYPOINT ["/app/entrypoint.sh"]
