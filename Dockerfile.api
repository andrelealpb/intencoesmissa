FROM node:22-slim AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Copy monorepo root files
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* .npmrc ./

# Copy packages
COPY packages/ ./packages/

# Copy prisma
COPY prisma/ ./prisma/

# Copy api app
COPY apps/api/ ./apps/api/

# Install dependencies
RUN pnpm install --frozen-lockfile || pnpm install

# Generate Prisma client
RUN pnpm exec prisma generate --schema=prisma/schema.prisma

# Build shared package first, then API
RUN pnpm --filter @missas/shared build && pnpm --filter @missas/api build

# Create entrypoint script
RUN printf '#!/bin/sh\npnpm exec prisma migrate deploy --schema=prisma/schema.prisma\nnode apps/api/dist/main.js\n' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh

EXPOSE 3001
ENV PORT=3001

ENTRYPOINT ["/app/entrypoint.sh"]
