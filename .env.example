DATABASE_URL=postgresql://postgres:postgres@localhost:5432/missas_intencoes

# ── Auth admin (Intenções) ──────────────────────────────
# Secret do JWT de admin. NÃO pode coincidir com MEMBER_JWT_SECRET (D1).
JWT_SECRET=troque-em-producao

# ── Escala · Auth de membro (S5) ────────────────────────
# Realm de membro (voluntário) — link mágico / OTP, isolado do admin (D1).
# MEMBER_JWT_SECRET é OBRIGATÓRIA em produção e deve ser distinta de JWT_SECRET.
MEMBER_JWT_SECRET=troque-em-producao-membro
# TTL do JWT de membro (sessão de baixo privilégio, sem refresh no MVP).
MEMBER_JWT_TTL=30d
# TTL do código OTP (minutos).
OTP_TTL_MIN=10
# TTL do link mágico (minutos).
MAGIC_LINK_TTL_MIN=20
# Base do portal do membro, usada para montar o link mágico
# (MEMBER_PORTAL_URL/p/{slug}/escala/entrar?token=…).
MEMBER_PORTAL_URL=http://localhost:3000
