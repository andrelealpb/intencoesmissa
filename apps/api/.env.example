DATABASE_URL=postgresql://postgres:postgres@localhost:5432/missas_intencoes
JWT_SECRET=change-me-to-a-secure-random-string
PORT=3001
CORS_ORIGINS=http://localhost:3000

# Email — Brevo (https://app.brevo.com)
BREVO_API_KEY=your-brevo-api-key
SMTP_FROM=noreply@your-verified-domain.com
SMTP_FROM_NAME=Intencoes de Missa

# Storage — AWS S3
# S3_ENDPOINT only needed for S3-compatible services (MinIO, etc). Leave empty for AWS.
S3_REGION=us-east-1
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_PUBLIC_BASE_URL=
