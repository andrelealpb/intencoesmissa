DATABASE_URL=postgresql://postgres:postgres@localhost:5432/missas_intencoes
JWT_SECRET=change-me-to-a-secure-random-string
PORT=3001
CORS_ORIGINS=http://localhost:3000

# Email — MailerSend API (https://app.mailersend.com)
MAILERSEND_API_TOKEN=your-mailersend-api-token
SMTP_FROM=noreply@your-verified-domain.com

# Storage — AWS S3
# S3_ENDPOINT only needed for S3-compatible services (MinIO, etc). Leave empty for AWS.
S3_REGION=us-east-1
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_PUBLIC_BASE_URL=
